render 'image-with-text-slider-image', image: block.settings.image4, caption: block.settings.image4_caption, aspect_ratio: block.settings.gallery_aspect
endif
if block.settings.image5 != blank or block.settings.image5_caption
render 'image-with-text-slider-image', image: block.settings.image5, caption: block.settings.image5_caption, aspect_ratio: block.settings.gallery_aspect
endif
if block.settings.image6 != blank or block.settings.image6_caption
render 'image-with-text-slider-image', image: block.settings.image6, caption: block.settings.image6_caption, aspect_ratio: block.settings.gallery_aspect
endif
-%}
</div>

</css-slider>

</div>

{%- endcase -%}
{%- endfor -%}

</div>

{%- if first_3d_model -%}
<script type="application/json" id="ProductJSON-{{ product.id }}">
{{ product.media | where: 'media_type', 'model' | json }}
</script>
{%- endif -%}

</product-page>

<script>
// JavaScript to handle dynamic shade loading and add to cart
(function() {
  // Function to fetch product data and render shades
  function loadProductShades(handle, container, type) {
    if (!handle) return;
    
    $.ajax({
      url: '/products/' + handle + '.js',
      dataType: 'json',
      success: function(product) {
        if (!product || !product.variants) return;
        
        var html = '';
        var first = true;
        var variantIndex = 0;
        
        product.variants.forEach(function(variant) {
          // Get the shade name from option1 (assuming that's where the shade is stored)
          var shadeName = variant.option1 || variant.title;
          var checked = first ? 'checked=""' : '';
          var selectedClass = first ? 'selected-var' : '';
          var firstClass = first ? 'firsty' : '';
          var inputClass = type === 'concealer' ? 'product-variant__input' : 'product-variant__input1';
          var labelClass = type === 'concealer' ? 'product-variant__label' : 'product-variant__label1';
          
          // Get variant image or use product featured image
          var imageUrl = '';
          if (variant.featured_image) {
            imageUrl = variant.featured_image;
          } else if (product.featured_image) {
            imageUrl = product.featured_image;
          } else {
            // Try to construct image URL from shade name (common pattern)
            imageUrl = '//cdn.shopify.com/s/files/1/0555/4018/7214/files/' + shadeName.replace(/\s+/g, '-') + '.png';
          }
          
          html += '<div class="product-variant__item product-variant__item--color ' + firstClass + '">';
          html += '<input type="radio" name="product-color-' + type + '" id="' + type + '-option-color-' + variantIndex + '" value="' + shadeName + '" ' + checked + ' class="' + inputClass + ' product-variant-value">';
          html += '<span class="tooltiptext">' + shadeName + '</span>';
          html += '<label data-varid="' + variant.id + '" for="' + type + '-option-color-' + variantIndex + '" class="' + labelClass + ' ' + selectedClass + '">';
          html += '<span aria-hidden="true" style="background-image: url(' + imageUrl + '); width: 44px; height: 44px; display: block; background-size: cover; background-position: center;"></span>';
          html += '</label>';
          html += '</div>';
          
          first = false;
          variantIndex++;
        });
        
        container.html(html);
        
        // Update selected shade text
        if (product.variants.length > 0) {
          var selectedShade = type === 'concealer' ? '.concealer-selected-shade span' : '.foundation-selected-shade span';
          var firstShade = product.variants[0].option1 || product.variants[0].title;
          $(selectedShade).html(firstShade);
        }
      },
      error: function(xhr, status, error) {
        console.error('Error loading product:', handle, error);
      }
    });
  }
  
  // Handle concealer dropdown change
  $(document).on('change', '#concealer-select', function() {
    var selectedHandle = $(this).find('option:selected').attr('data-attr');
    var container = $('.concealer-shades-container');
    loadProductShades(selectedHandle, container, 'concealer');
  });
  
  // Handle foundation dropdown change
  $(document).on('change', '#foundation-select', function() {
    var selectedHandle = $(this).find('option:selected').attr('data-attr');
    var container = $('.foundation-shades-container');
    loadProductShades(selectedHandle, container, 'foundation');
  });
  
  // Handle shade selection clicks
  $(document).on('click', '.concealer-custom-shades .product-variant__input', function() {
    $('.concealer-selected-shade span').html($(this).val());
    $('.concealer-custom-shades .product-variant__label').removeClass('selected-var');
    $(this).next().next().addClass('selected-var');
  });
  
  $(document).on('click', '.foundation-custom-shades .product-variant__input1', function() {
    $('.foundation-selected-shade span').html($(this).val());
    $('.foundation-custom-shades .product-variant__label1').removeClass('selected-var');
    $(this).next().next().addClass('selected-var');
  });
  
  // Initialize shades for first products on page load
  $(document).ready(function() {
    setTimeout(function() {
      var firstConcealer = $('#concealer-select option:first').attr('data-attr');
      if (firstConcealer) {
        var container = $('.concealer-shades-container');
        loadProductShades(firstConcealer, container, 'concealer');
      }
      
      var firstFoundation = $('#foundation-select option:first').attr('data-attr');
      if (firstFoundation) {
        var container = $('.foundation-shades-container');
        loadProductShades(firstFoundation, container, 'foundation');
      }
    }, 500);
  });
})();
</script>

<style>
.product-variant{
margin-bottom: 30px;
}
.concealer-selected-shade, .foundation-selected-shade{
display: block;
margin: 20px 0;
font-weight: 500;
}
.select-text{
font-size: 1.3em;
font-weight: 500;
margin-top: 1em;
}
select{
background-color: deeppink;
font-weight: 500;
width: 100%;
color: #fff;
border: none;
padding: 10px;
margin-bottom: 15px;
}
.product-variant__item {
position: relative;
display: inline-block;
margin: 5px;
}
.product-variant__item .tooltiptext {
visibility: hidden;
font-size: 14px;
color: #000;
font-family: inter;
font-weight: 500;
text-align: center;
padding: 0px 15px;
border-radius: 6px;
position: absolute;
z-index: 1;
left: 50%;
transform: translateX(-50%);
top: -36px;
background: #fff;
box-shadow: 0 2px 8px rgba(0,0,0,0.1);
}

.product-variant__item:hover .tooltiptext {
visibility: visible;
}
@media only screen and (max-width: 768px) {
.set-mobile-position, .product__variants {
padding-left: 15px;
}
}
</style>

{% schema %}
{
"name": "Concealer Foundation",
"class": "mount-product-page mount-product-gallery mount-css-slider main-product section-w-margin",
"tag": "section",
"blocks": [
{
"type": "@app"
},
{
"type": "header",
"name": "t:sections.highlight-extra-words.product-page.product-header.header",
"limit": 1,
"settings": [
{
"type": "checkbox",
"id": "show_vendor",
"label": "t:sections.highlight-extra-words.product-page.product-header.show_vendor",
"default": true
},
{
"type": "checkbox",
"id": "show_reviews",
"label": "t:sections.highlight-extra-words.product-page.product-header.show_reviews",
"default": true
},
{
"type": "checkbox",
"id": "show_tax_info",
"label": "t:sections.highlight-extra-words.product-page.product-header.show_tax_info",
"default": false
},
{
"type": "checkbox",
"id": "show_sku",
"label": "t:sections.highlight-extra-words.product-page.product-header.show_sku",
"default": false
},
{
"type": "checkbox",
"id": "show_barcode",
"label": "t:sections.highlight-extra-words.product-page.product-header.show_barcode",
"default": false
},
